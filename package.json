{
  "name": "picky",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build": "expo export --platform web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx || exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force .\\node_modules\\.cache -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force .\\.turbo -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force .\\dist -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force .\\build -ErrorAction SilentlyContinue; Get-ChildItem -Recurse -Filter tsconfig.tsbuildinfo | Remove-Item -Force -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@supabase/supabase-js": "^2.45.1",
    "dayjs": "^1.11.13",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-blur": "~13.0.3",
    "expo-calendar": "~14.0.6",
    "expo-clipboard": "^8.0.7",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "^15.0.7",
    "expo-image-manipulator": "~13.0.3",
    "expo-image-picker": "~16.0.5",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-secure-store": "~14.0.1",
    "leo-profanity": "^1.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "18.3.8",
    "@types/react-native": "^0.72.8",
    "typescript": "5.6.3"
  }
}
