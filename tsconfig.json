{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "lib": ["ESNext"],
  "types": ["react", "node"],
    "paths": {
      "@/components/*": ["components/*"],
      "@/app/*": ["app/*"],
      "@/services/*": ["services/*"],
      "@/theme/*": ["theme/*"],
      "@/types/*": ["types/*"],
      "@/utils/*": ["utils/*"],
      "@/hooks/*": ["hooks/*"]
    }
  }
}
