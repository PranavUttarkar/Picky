{
  "expo": {
    "name": "Picky",
    "slug": "picky",
    "scheme": "picky",
    "version": "0.1.0",
    "orientation": "portrait",
  "icon": "./assets/branding/P.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/branding/P.png", "backgroundColor": "#111827" }
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/branding/P.png" },
    "plugins": [
      ["expo-router"],
      ["expo-notifications"],
      ["expo-calendar"],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Picky to access your photos so you can upload event pictures.",
          "cameraPermission": "Allow Picky to use your camera to take a photo for your event."
        }
      ]
    ],
    "experiments": { "tsconfigPaths": true }
  }
}
