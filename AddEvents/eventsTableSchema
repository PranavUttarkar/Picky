create table public.events (
  id bigserial not null,
  title text not null,
  description text null,
  image_url text null,
  date_time timestamp with time zone not null,
  location text null,
  tags text[] null default '{}'::text[],
  rsvp_url text null,
  created_by uuid null,
  image_urls text[] null,
  constraint events_pkey primary key (id),
  constraint events_created_by_fkey foreign KEY (created_by) references users (id),
  constraint events_image_urls_length_check check (
    (
      (image_urls is null)
      or (cardinality(image_urls) <= 3)
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_events_datetime on public.events using btree (date_time) TABLESPACE pg_default;

create index IF not exists idx_events_tags on public.events using gin (tags) TABLESPACE pg_default;